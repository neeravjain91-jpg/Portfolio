# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production keys to source control.
# ==============================================================================

# Resend Email Delivery API (https://resend.com)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Primary Contact Notification Inboxes
CONTACT_TO_EMAIL=neeravjain91@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Upstash Distributed Redis Rate Limiter (https://upstash.com)
# Optional in local development; defaults to in-memory sliding-window limiter if omitted.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://neerav-jain-portfolio.vercel.app
